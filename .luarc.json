{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "runtime": {
        "version": "Lua5.2",
        "requirePattern": [
            "?",
            "?.lua"
        ]
    },
    "workspace": {
        "library": [
            "/home/qeela/.config/Code/User/workspaceStorage/4fc48d78ac86dccc427d9e1aad3c0c58/justarandomgeek.factoriomod-debug/emmylua/factorio/library"
        ],
        "moduleMap": [
            {
                "pattern": "^__(.*)__(.*)$",
                "replace": "$1$2"
            },
            {
                "pattern": "^(.*)\\.lua$",
                "replace": "$1"
            }
        ]
    },
    "diagnostics": {
        "disable": [
            "unnecessary-if"
        ]
    }
}